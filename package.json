{
  "name": "nex-app-kit",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "NEX app templates — the frame of an ICC app (left panel, top bar, Getting started, Updates, Settings) on top of nex-shared, and the standard server interface it uses.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frame.css": "./dist/frame.css",
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    }
  },
  "scripts": {
    "build": "tsup && cp src/frame.css dist/frame.css",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "@tailwindcss/typography": "^0.5",
    "msw": "^2",
    "nex-shared": "*",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10",
    "react-router-dom": "^7",
    "remark-gfm": "^4",
    "tailwindcss": "^4.3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.0",
    "msw": "^2.15.0",
    "nex-shared": "github:rauschiccsk/nex-shared#v0.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "react-router-dom": "^7.1.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.5",
    "vitest": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  }
}
