    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "nex-shared": "github:rauschiccsk/nex-shared#v0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "react-router-dom": "^7.1.0",
    "remark-gfm": "^4.0.0",
