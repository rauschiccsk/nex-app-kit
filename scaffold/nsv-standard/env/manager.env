
# --- The app template (nex-app-kit) ---
# Database — the cockpit writes its own values at deploy.
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+pg8000://{{DB_NAME}}:CHANGE_ME@db:5432/{{DB_NAME}}
# The address of this installation exactly as the browser opens it (https:// = the session cookie on https only).
# @public-url
PUBLIC_URL=
# Launched from NEX Manager — the cockpit writes the paired values at deploy; empty = not paired yet, the launch
# says so and the app keeps running.
NEX_MANAGER_BASE_URL=
NEX_MANAGER_API_KEY=
MANAGER_LAUNCH_SIGNING_KEY=
MANAGER_MODULE_SLUG={{SLUG}}
MANAGER_DEPLOY_SLUG=
